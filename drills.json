{
 "linux": [
  {
   "q": "Which command shows a long listing with human-readable sizes and hidden files?",
   "opts": [
    "ls -lh",
    "ls -la",
    "ls -lah",
    "ls -h"
   ],
   "a": 2,
   "why": "-l long, -a all (hidden), -h human sizes."
  },
  {
   "q": "What does chmod 4755 file do?",
   "opts": [
    "RWX for owner, RX group/other",
    "Sets SUID bit",
    "Sets sticky bit",
    "Recursive change"
   ],
   "a": 1,
   "why": "4xxx = SUID: file runs with owner privileges — classic privesc vector."
  },
  {
   "q": "Find SUID binaries on a system:",
   "opts": [
    "find / -perm -4000 2>/dev/null",
    "find / -suid",
    "ls -suid /",
    "grep suid /etc/passwd"
   ],
   "a": 0,
   "why": "-perm -4000 matches SUID; GTFOBins tells you which are exploitable."
  },
  {
   "q": "Which file lists user shells for login?",
   "opts": [
    "/etc/shells",
    "/etc/passwd",
    "/etc/login",
    "/bin/bashrc"
   ],
   "a": 1,
   "why": "/etc/passwd: user:x:uid:gid:comment:home:shell."
  },
  {
   "q": "Cron job running a world-writable script as root = ?",
   "opts": [
    "Nothing, cron is safe",
    "Privesc via editing the script",
    "Only DoS possible",
    "Needs kernel exploit"
   ],
   "a": 1,
   "why": "Writable path executed by root → put your payload in it."
  },
  {
   "q": "What does '2>/dev/null' do?",
   "opts": [
    "Deletes stderr",
    "Redirects stderr to null device",
    "Hides stdout",
    "Restarts process"
   ],
   "a": 1,
   "why": "Silence permission-denied noise during recursive finds."
  }
 ],
