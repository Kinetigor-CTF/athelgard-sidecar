{
  "manifest_version": 3,
  "name": "Athelgard Sidecar",
  "version": "1.0.0",
  "description": "Athelgard — side-panel AI teammate. Shared page awareness, durable flag pipeline with explicit send gate. Born from the Holmes 2026 post-mortem: no flag dies in chat.",
  "permissions": [
    "sidePanel",
    "storage",
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Athelgard"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
